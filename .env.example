# ---------------------------------------------------------------------------
# TuneRoom environment
# Copy to `.env` and adjust. Every variable is optional for local development.
# ---------------------------------------------------------------------------

# Secret used to sign guest identity tokens (HMAC).
# Generate one with: openssl rand -hex 32
# REQUIRED in production.
NUXT_SESSION_SECRET="dev-only-secret-change-me"

# PostgreSQL connection string. When set, TuneRoom talks to a real PostgreSQL
# server through node-postgres (recommended for production).
# When empty, TuneRoom falls back to an embedded PostgreSQL (PGlite) stored on
# disk at PGDATA_DIR — perfect for local development, no server required.
# DATABASE_URL="postgres://user:password@localhost:5432/tuneroom"

# Directory used by the embedded PostgreSQL fallback.
PGDATA_DIR=".data/pg"

# File storage driver. Only "local" ships with the MVP; see PROJECT.md for how
# to register an S3-compatible driver behind the same interface.
STORAGE_DRIVER="local"

# Where uploaded audio + cover art is written (local driver).
STORAGE_DIR=".data/storage"

# Public origin of the app. Used for share links and the room QR code.
# Leave empty to derive it from the incoming request.
PUBLIC_APP_URL=""

# Upload limits
MAX_UPLOAD_MB="60"
MAX_URL_FETCH_MB="60"

# Set to "false" to disable the in-memory rate limiter (not recommended).
RATE_LIMIT_ENABLED="true"
